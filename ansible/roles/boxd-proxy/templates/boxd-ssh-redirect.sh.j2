#!/bin/bash
set -e
RANGE="{{ ssh_port_range_start | default(10000) }}:{{ ssh_port_range_end | default(30000) }}"
TARGET="{{ proxy_ssh_port | default(22) }}"
iptables -t nat -C PREROUTING -p tcp --dport "$RANGE" -j REDIRECT --to-ports "$TARGET" 2>/dev/null \
  || iptables -t nat -I PREROUTING -p tcp --dport "$RANGE" -j REDIRECT --to-ports "$TARGET"
