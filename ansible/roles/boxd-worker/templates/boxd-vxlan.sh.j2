#!/bin/bash
set -e
{% set worker = boxd_workers | selectattr('name', 'equalto', inventory_hostname) | first %}

LOCAL_IP={{ vrack_ip }}

VNI={{ worker.vni }}
IFACE="vxlan${VNI}"
if ! ip link show "$IFACE" &>/dev/null; then
    ip link add "$IFACE" type vxlan id "$VNI" local "$LOCAL_IP" dstport 4789 nolearning
{% for proxy in groups['proxy'] %}
    bridge fdb append 00:00:00:00:00:00 dev "$IFACE" dst {{ hostvars[proxy].vrack_ip }}
{% endfor %}
{% for peer in boxd_workers | rejectattr('name', 'equalto', inventory_hostname) %}
    bridge fdb append 00:00:00:00:00:00 dev "$IFACE" dst {{ peer.vrack_ip }} self permanent
{% endfor %}
    ip link set "$IFACE" master boxd-br0
    ip link set "$IFACE" up
fi

{% for peer in boxd_workers | rejectattr('name', 'equalto', inventory_hostname) %}
PEER_IFACE="vxlan{{ peer.vni }}"
if ! ip link show "$PEER_IFACE" &>/dev/null; then
    ip link add "$PEER_IFACE" type vxlan id {{ peer.vni }} local "$LOCAL_IP" dstport 4789 nolearning
    ip link set "$PEER_IFACE" up
fi
bridge fdb append 00:00:00:00:00:00 dev "$PEER_IFACE" dst {{ peer.vrack_ip }} self permanent
{% set my_index = (boxd_workers | map(attribute='name') | list).index(inventory_hostname) %}
ip addr replace {{ peer.bridge_subnet | regex_replace('0\\.0/16$', '0.' ~ (250 - my_index) | string ~ '/16') }} dev "$PEER_IFACE" 2>/dev/null || true
ip route replace {{ peer.bridge_subnet }} dev "$PEER_IFACE"
{% endfor %}
