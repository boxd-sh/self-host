#!/usr/bin/env bash
# Run the boxd installer with every tool it needs, from a Docker image — so
# the only thing to install is Docker.
#
#   ./boxd-install validate | apply | providers edit | …   ./install.py <args>
#   ./boxd-install gcloud auth login --no-launch-browser     a tool in the image
#   ./boxd-install aws sso login --use-device-code
#   ./boxd-install kubectl -n boxd get pods                  GKE clusters (credentials: below)
#   ./boxd-install shell                                     a shell in the image
#   ./boxd-install windows-image build --iso FILE            the cluster's Windows image, built
#                                                            on this host (KVM, Docker) and pushed
#
# Your gcloud and aws logins live in ~/.config/gcloud and ~/.aws (shared with
# any host install); gcloud's ssh key in ~/.config/boxd-install/ssh; kubectl's
# credentials (`./boxd-install gcloud container clusters get-credentials …`)
# in ~/.config/boxd-install/kube, never your own ~/.kube. BOXD_STATE_KEY, BOXD_PRODUCT_LICENSE and AWS_* pass
# through from your environment by name; their values never reach a command
# line. So does BOXD_RELEASES_URL (a copy of boxd's release bucket, for
# tests); a file:// one is mounted read-only at the same path. The image is ghcr.io/boxd-sh/self-host-tools:<docker/VERSION>;
# if it can't be pulled it is built locally from docker/Dockerfile.
# BOXD_INSTALLER_IMAGE overrides it.
set -euo pipefail
cd "$(dirname "$0")"
# windows-image's usage needs no tools image.
if [ "${1:-}" = windows-image ]; then
    case "${2:-}" in
        build) for a in "${@:3}"; do
                   case "$a" in -h|--help) exec ./boxd_installer/windows-image-build.sh --help ;; esac
               done ;;
        -h|--help|"") exec ./boxd_installer/windows-image-build.sh --help ;;
        *) echo "boxd-install: windows-image has one action, build" >&2; exit 2 ;;
    esac
fi

IMAGE="${BOXD_INSTALLER_IMAGE:-ghcr.io/boxd-sh/self-host-tools:$(cat docker/VERSION)}"
if ! docker image inspect "$IMAGE" >/dev/null 2>&1 && ! err=$(docker pull -q "$IMAGE" 2>&1); then
    echo "boxd-install: can't pull $IMAGE — not published, not public, or no network (${err##*$'\n'})" >&2
    echo "boxd-install: building it locally instead — once, a few minutes, ~1.8 GB" >&2
    docker build -t "$IMAGE" docker >&2
fi

mkdir -p "$HOME/.config/gcloud" "$HOME/.aws"
# The container's own ~/.ssh: gcloud compute ssh keeps its key there. Without
# it every run minted a new key and added it to the project's ssh metadata.
SSH_DIR="$HOME/.config/boxd-install/ssh"
mkdir -p "$SSH_DIR" && chmod 700 "$SSH_DIR"
KUBE_DIR="$HOME/.config/boxd-install/kube"
mkdir -p "$KUBE_DIR" && chmod 700 "$KUBE_DIR"
# The editor for `providers edit` must exist in the image.
case "${EDITOR:-}" in vi|vim|nano) ;; *) EDITOR=nano ;; esac

args=(--rm -i --user "$(id -u):$(id -g)"
      -v "$PWD:/work" -w /work
      -v "$HOME/.config/gcloud:/home/installer/.config/gcloud"
      -v "$HOME/.aws:/home/installer/.aws"
      -v "$SSH_DIR:/home/installer/.ssh"
      -v "$KUBE_DIR:/home/installer/.kube"
      -e EDITOR="$EDITOR")
# Not for windows-image: its kit step's stdout is read below, and a TTY would merge stderr into it.
[ -t 0 ] && [ -t 1 ] && [ "${1:-}" != windows-image ] && args+=(-t)
for v in BOXD_STATE_KEY BOXD_PRODUCT_LICENSE BOXD_RELEASES_URL \
         AWS_PROFILE AWS_REGION AWS_DEFAULT_REGION \
         AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN \
         CLOUDSDK_CORE_PROJECT; do
    [ -n "${!v:-}" ] && args+=(-e "$v")
done
# A gcloud credential file override (a service account key in CI, say), at the same file inside
# the image: it must be under ~/.config/gcloud, which is mounted there.
if [ -n "${CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE:-}" ]; then
    case "$CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE" in
        "$HOME/.config/gcloud/"*)
            args+=(-e "CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE=/home/installer/.config/gcloud/${CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE#"$HOME/.config/gcloud/"}") ;;
        *) echo "boxd-install: CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE must name a file under ~/.config/gcloud" >&2
           exit 1 ;;
    esac
fi
case "${BOXD_RELEASES_URL:-}" in
    file:///*) d="${BOXD_RELEASES_URL#file://}"
               [ -d "$d" ] || { echo "boxd-install: BOXD_RELEASES_URL: no directory $d" >&2; exit 1; }
               args+=(-v "$d:$d:ro") ;;
esac

case "${1:-}" in
    gcloud|aws|terraform|ansible|ansible-playbook|ssh|kubectl) exec docker run "${args[@]}" "$IMAGE" "$@" ;;
    shell) shift; exec docker run "${args[@]}" "$IMAGE" bash "$@" ;;
    # The release's Windows image kit from the tools image, then the build on this host, which
    # needs its /dev/kvm and Docker (boxd_installer/windows-image-build.sh).
    windows-image)
        kit=$(docker run "${args[@]}" "$IMAGE" ./install.py windows-image kit) || exit 1
        shift 2
        BOXD_KIT_INFO="$kit" exec ./boxd_installer/windows-image-build.sh "$@" ;;
    *) exec docker run "${args[@]}" "$IMAGE" ./install.py "$@" ;;
esac
